# Copy to .env (gitignored, chmod 600). Never commit real keys.
GEMINI_API_KEY=
# Optional, only for the Claude Code / Grokbot adapters
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Demo switch: 1 = Tripwire enforces verdicts, 0 = compute + log but let checkout through
TRIPWIRE_ENFORCED=1
# Coarse delivery area for price/delivery quotes (no street, no name). Set to the shopper's area.
SHIP_TO_COUNTRY=US
SHIP_TO_REGION=NY
SHIP_TO_CITY=New York
SHIP_TO_POSTAL=10001
